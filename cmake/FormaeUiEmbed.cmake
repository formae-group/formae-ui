# FormaeUiEmbed.cmake - formae_ui_embed_file(<target> <name> <file>).
#
# Embeds a binary file (a logo, a font) in <target> as a byte array, so the
# program needs no loose file. It writes <name>.c and <name>.h under the
# build tree's formae_embed/ folder, adds the source to <target> and the
# folder to its include path. The header declares, with C linkage:
#
#   extern const unsigned char <name>[];
#   extern const size_t <name>_size;
#
# CMake configures again when the file changes.
function(formae_ui_embed_file target name file)
    get_filename_component(_file "${file}" ABSOLUTE)
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "formae_ui_embed_file: no such file: ${_file}")
    endif()
    if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "formae_ui_embed_file: '${name}' is not a C identifier")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
    file(READ "${_file}" _bytes HEX)
    string(REGEX REPLACE "(................................................................)" "\\1\n" _bytes "${_bytes}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_bytes}")
    set(_dir "${CMAKE_CURRENT_BINARY_DIR}/formae_embed")
    file(CONFIGURE OUTPUT "${_dir}/${name}.c" CONTENT [[
/* Generated by formae_ui_embed_file from @_file@. */
#include <stddef.h>
const unsigned char @name@[] = {
@_bytes@
};
const size_t @name@_size = sizeof @name@;
]] @ONLY)
    file(CONFIGURE OUTPUT "${_dir}/${name}.h" CONTENT [[
/* Generated by formae_ui_embed_file from @_file@. */
#pragma once
#include <stddef.h>
#ifdef __cplusplus
extern "C" {
#endif
extern const unsigned char @name@[];
extern const size_t @name@_size;
#ifdef __cplusplus
}
#endif
]] @ONLY)
    target_sources(${target} PRIVATE "${_dir}/${name}.c")
    target_include_directories(${target} PRIVATE "${_dir}")
endfunction()
